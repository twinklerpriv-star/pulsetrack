# Umgebungsvariablen: PulseTrack
# Datum: 31.05.2026 | Version: 1.1 | Status: Vorlage (NICHT in Git einchecken!)
#
# Anleitung:
#   1. Diese Datei kopieren: cp .env.example .env
#   2. Werte in .env anpassen
#   3. .env wird automatisch von Docker Compose und uvicorn geladen

# PFLICHT: Durch ein sicheres, zufälliges Secret ersetzen!
# Generieren mit: py -c "import secrets; print(secrets.token_hex(32))"
ANALYTICS_SALT_SECRET=change-me-in-production

# Pfad zur SQLite-Datenbank (im Docker-Volume: /data/analytics.db)
ANALYTICS_DB_PATH=analytics.db

# Stripe Billing Configuration (Test- oder Live-Keys)
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_PUBLISHABLE_KEY=pk_test_change_me
STRIPE_PRICE_STARTER=price_starter_change_me
STRIPE_PRICE_BUSINESS=price_business_change_me
STRIPE_PRICE_ENTERPRISE=price_enterprise_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# SMTP E-Mail Server Konfiguration (B2B Transactional Emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=smtp_password_change_me

# Optional: Entwicklungsmodus im Setup-Assistenten anbieten (alle URLs erlauben)
# PULSETRACK_ALLOW_PERMISSIVE_SETUP=1

# Litestream SQLite S3-Echtzeit-Backup & Replikation (z. B. via Cloudflare R2 oder AWS S3)
# Siehe https://litestream.io für die Einrichtung
LITESTREAM_BUCKET=pulsetrack-backups
LITESTREAM_REGION=eu-central-1
LITESTREAM_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=r2_access_key_here
LITESTREAM_SECRET_ACCESS_KEY=r2_secret_key_here

