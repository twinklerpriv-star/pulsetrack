# Umgebungsvariablen: PulseTrack
# Datum: 20.05.2026 | Version: 1.0 | Status: Vorlage (NICHT in Git einchecken!)
#
# Anleitung:
#   1. Diese Datei kopieren: cp .env.example .env
#   2. Werte in .env anpassen
#   3. .env wird automatisch von Docker Compose und uvicorn geladen

# PFLICHT: Durch ein sicheres, zufälliges Secret ersetzen!
# Generieren mit: python -c "import secrets; print(secrets.token_hex(32))"
ANALYTICS_SALT_SECRET=change-me-in-production

# Pfad zur SQLite-Datenbank (im Docker-Volume: /data/analytics.db)
ANALYTICS_DB_PATH=analytics.db
